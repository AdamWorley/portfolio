# Cloudflare Pages headers.
# Astro inlines this site's stylesheet and its one small module script, so
# script-src/style-src must permit 'unsafe-inline'. The rest of the policy
# still does real work: nothing external may be loaded, framed or embedded.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Hashed by the build: safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Social preview image: not hashed, so it keeps a stable URL for scrapers.
/og.webp
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/android-chrome-192x192.png
  Cache-Control: public, max-age=604800
/android-chrome-512x512.png
  Cache-Control: public, max-age=604800

# HTML always revalidates so a content edit goes live immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate
