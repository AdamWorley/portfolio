---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import Base from "../layouts/Base.astro";
import Rail from "../components/Rail.astro";
import Icon from "../components/Icon.astro";
import panels from "../content/panels.json";
import hero from "../assets/panels/hero.png";

import { frontmatter as introData, Content as IntroBody } from "../content/intro.md";
import { frontmatter as aboutData, Content as AboutBody } from "../content/about.md";
import { frontmatter as contactData } from "../content/contact.md";

// Panel art is referenced by filename in panels.json so the content file stays
// editable. Astro needs a real import to process an image, so the whole folder
// is globbed eagerly and looked up by name at build time.
const art = import.meta.glob<{ default: ImageMetadata }>("../assets/panels/*.png", {
  eager: true,
});

const panelArt = (file: string) => {
  const found = art[`../assets/panels/${file}`];
  if (!found) throw new Error(`panels.json references missing art: ${file}`);
  return found.default;
};

// A project panel is a quarter of the album at full width, half at tablet, and
// the whole column on a phone. The life panels are a third, then a half.
const PROJECT_SIZES = "(max-width: 620px) 100vw, (max-width: 1000px) 50vw, 25vw";
const LIFE_SIZES = "(max-width: 620px) 100vw, (max-width: 1000px) 50vw, 33vw";
---

<Base>
  <Rail home={true} />

  <main class="album">
    <!-- Tier 1: the establishing panel -->
    <section class="tier" aria-labelledby="who">
      <figure class="panel panel--hero">
        <Image
          class="panel__img"
          src={hero}
          alt="Adam Worley in profile at his desk, typing on an open laptop, a London skyline of towers, a dome and construction cranes filling the window behind."
          widths={[640, 960, 1360, 1920]}
          sizes="(max-width: 1384px) 100vw, 1360px"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="caption caption--in">
          <span class="caption__name" id="who">{introData.name}</span>
          <span class="caption__role">{introData.role}</span>
        </figcaption>
        <p class="caption caption--lede">{introData.lede}</p>
      </figure>
    </section>

    <!-- Tier 2: the narration panel -->
    <section class="tier cut" style={`--cut:1`} id="work" aria-labelledby="work-h">
      <div class="tier__head">
        <h2 id="work-h">The Work</h2>
      </div>
      <div class="panel panel--text">
        <div class="prose">
          <IntroBody />
        </div>
      </div>
    </section>

    <!-- Tier 3: projects. On a tall window this row is already inside the first
         screen, so the four panels load eagerly; only the hero keeps the high
         fetch priority, so it stays the largest paint. -->
    <section class="tier tier--projects cut" style={`--cut:2`} id="projects" aria-labelledby="projects-h">
      <div class="tier__head">
        <h2 id="projects-h">Projects</h2>
      </div>
      {
        panels.projects.map((p) => (
          <a class="panel panel--link" href={p.link} rel="noopener">
            <Image
              class="panel__img"
              src={panelArt(p.image)}
              alt={p.alt}
              widths={[400, 660, 900]}
              sizes={PROJECT_SIZES}
              format="webp"
              loading="eager"
            />
            <span class="panel__strip">
              <h3>
                {p.title} <Icon name="external" size={15} />
              </h3>
              <p>{p.caption}</p>
            </span>
          </a>
        ))
      }
    </section>

    <!-- Tier 4: the narration panel for life away from the keyboard -->
    <section class="tier cut" style={`--cut:3`} id="life" aria-labelledby="life-h">
      <div class="tier__head">
        <h2 id="life-h">{aboutData.title}</h2>
      </div>
      <div class="panel panel--text">
        <div class="prose">
          <AboutBody />
        </div>
      </div>
    </section>

    <!-- Tier 5: the life panels -->
    <section class="tier tier--life cut" style={`--cut:4`} aria-label="Away from the keyboard">
      {
        panels.personal.map((p) => (
          <figure class="panel panel--life">
            <Image
              class="panel__img"
              src={panelArt(p.image)}
              alt={p.alt}
              widths={[450, 700, 900]}
              sizes={LIFE_SIZES}
              format="webp"
            />
            <figcaption class="panel__strip">
              <h3>{p.title}</h3>
              <p>{p.caption}</p>
            </figcaption>
          </figure>
        ))
      }
    </section>

    <!-- Tier 6: the close -->
    <section class="tier cut" style={`--cut:5`} id="contact" aria-labelledby="contact-h">
      <div class="panel panel--text">
        <div class="contact">
          <p class="contact__lead" id="contact-h">{contactData.title}</p>
          <a class="btn btn--primary" href={`mailto:${contactData.email}`}>
            <Icon name="mail" />
            {contactData.email}
          </a>
          <a class="btn" href={contactData.github} rel="me noopener">
            <Icon name="github" />
            {contactData.githubLabel}
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot__inner">
      <span>Adam Worley, Senior Software Developer</span>
      <span style="margin-left:auto"><a href="https://blog.adamworley.com/blog">Blog</a></span>
    </div>
  </footer>
</Base>

<script>
  // The rail marks the tier you are reading, in the album's own active state.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".rail__nav a")];
  const sections = links
    .map((a) => document.querySelector(a.hash))
    .filter((el): el is Element => Boolean(el));

  // Comparing intersection ratios pits a short section against a tall one, so
  // the tiers that are only a heading and a paragraph won a fight they should
  // have lost. A reading line is height-blind: whichever tier has most recently
  // crossed it is the one being read, and the tiers with no link of their own
  // (the life panels) simply leave the tier above them marked.
  if (sections.length) {
    const mark = () => {
      const line = window.innerHeight * 0.4;
      const doc = document.documentElement;
      // The last tier is short and sits under the footer, so it never reaches
      // the reading line: within a footer's height of the bottom, it is what
      // you are looking at.
      const atEnd = window.scrollY + window.innerHeight >= doc.scrollHeight - 80;

      let active: Element | null = atEnd ? sections[sections.length - 1] : null;
      if (!atEnd) {
        for (const el of sections) {
          if (el.getBoundingClientRect().top <= line) active = el;
        }
      }

      links.forEach((a) => {
        if (active && a.hash === `#${active.id}`) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      });
    };

    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        mark();
      });
    };

    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    mark();
  }
</script>
