---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Rail from "../components/Rail.astro";
import sup from "../assets/panels/life-sup.png";
---

<Base title="404: Page not found | Adam Worley" description="That page isn't here.">
  <Rail />
  <main class="album">
    <section class="tier">
      <figure class="panel panel--hero">
        <Image
          class="panel__img"
          src={sup}
          alt="A stand-up paddleboard drifting alone on flat calm water."
          widths={[640, 960, 1360]}
          sizes="(max-width: 1384px) 100vw, 1360px"
          format="webp"
          loading="eager"
        />
        <figcaption class="caption caption--in">
          <span class="caption__name">404</span>
          <span class="caption__role">This panel is missing from the album</span>
        </figcaption>
      </figure>
    </section>
    <section class="tier">
      <div class="panel panel--text">
        <div class="contact">
          <p class="contact__lead">Nothing here but calm water.</p>
          <a class="btn btn--primary" href="/">Back to the first page</a>
        </div>
      </div>
    </section>
  </main>
  <footer class="foot">
    <div class="foot__inner"><span>Adam Worley, Senior Software Developer</span></div>
  </footer>
</Base>
