# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules
jspm_packages
**/node_modules/**

# Typescript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.*
!.env.example

.cache
**/.cache

# Astro build output and cache. (`public/` was ignored under Gatsby, which
# built into it; under Astro it is the static source directory and must be
# committed: it holds the icons and the social preview image.)
dist
.astro

# Impeccable working artifacts: decision-round sketches, QA screenshots and
# decision-page payloads. The durable records are committed: PRODUCT.md,
# DESIGN.md, .impeccable/design.json, the surface brief and the approved comps.
# The full-resolution panel masters are not design artifacts at all; they live
# in src/assets/panels/ and are build inputs.
.impeccable/sketches/
.impeccable/shots/
.impeccable/questions/

.idea
.vscode
.DS_Store